---
import Base from '../layouts/Base.astro';
---
<Base title="Página não encontrada" description="A página que você procurou não existe ou mudou de endereço. Veja as melhores cadeirinhas para carro ou use o comparador." noindex>
  <section class="hero"><div class="wrap">
    <h1>Página não encontrada.</h1>
    <p class="lead">O endereço pode ter mudado. Comece por aqui:</p>
    <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:24px">
      <a class="btn btn-marca" href="/melhor-cadeirinha-para-carro/">Melhores cadeirinhas</a>
      <a class="btn btn-linha" href="/comparador/">Comparador</a>
      <a class="btn btn-linha" href="/">Página inicial</a>
    </div>
  </div></section>
</Base>
