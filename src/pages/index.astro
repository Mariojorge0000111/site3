---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import FotoProduto from '../components/FotoProduto.astro';
import Nota from '../components/Nota.astro';
import BotaoML from '../components/BotaoML.astro';
import { imagemPost } from '../lib/blog';
import { PRODUTOS, produto, urlReview, imgProduto } from '../data/produtos';

const escolhas = [
  { slug: 'safety-1st-i-nxt-360', selo: 'Melhor no geral' },
  { slug: 'cosco-progress', selo: 'Melhor custo-benefício' },
  { slug: 'maxi-cosi-pebble-360-pro', selo: 'Melhor bebê conforto' },
  { slug: 'burigotto-protege-fix', selo: 'Melhor assento de elevação' },
].map((e) => ({ ...e, p: produto(e.slug) }));

const fases = [
  { titulo: 'Recém-nascido até 13 kg', texto: 'Bebê conforto ou cadeira conversível, sempre de costas para o movimento.', href: '/melhor-bebe-conforto/', rotulo: 'Bebês conforto' },
  { titulo: 'Uma cadeira de 0 a 36 kg', texto: 'Multigrupo que acompanha do nascimento aos 10 anos, com ou sem ISOFIX.', href: '/melhor-cadeirinha-para-carro/', rotulo: 'Cadeirinhas 0 a 36 kg' },
  { titulo: 'Giro 360° para o dia a dia', texto: 'Gira para a porta e facilita colocar a criança. Exige ISOFIX no carro.', href: '/melhor-cadeirinha-giratoria-360/', rotulo: 'Giratórias 360' },
  { titulo: 'De 4 a 10 anos (15 a 36 kg)', texto: 'Assento de elevação para o cinto do carro passar no lugar certo.', href: '/melhor-assento-de-elevacao/', rotulo: 'Assentos de elevação' },
];

// Dados enxutos para o seletor no navegador
const dadosSeletor = PRODUTOS.map((p) => ({
  slug: p.slug, nome: p.nome, faixa: p.faixa, kgMin: p.kgMin, kgMax: p.kgMax, categoria: p.categoria,
  semIsofix: p.isofix.startsWith('Não') || /cinto/i.test(p.isofix), nota: p.nota, img: imgProduto(p.imagem), ml: p.mlUrl, melhor: p.melhorPara,
}));

const faq = [
  { p: 'Qual a melhor cadeirinha para carro em 2026?', r: 'Na nossa avaliação, a **Safety 1st i-NXT 360** é a mais completa pelo preço: gira, tem homologação i-Size e vai do nascimento aos 36 kg. Para gastar menos, a **Cosco Progress** é a melhor relação custo-benefício. Veja a [lista completa](/melhor-cadeirinha-para-carro/).' },
  { p: 'Até que idade a criança precisa de cadeirinha?', r: 'Pela Resolução Contran 819/2021, até 10 anos ou 1,45 m de altura a criança viaja no banco de trás em dispositivo de retenção: bebê conforto, cadeirinha e depois assento de elevação até 7 anos e meio ou 1,45 m. Detalhes no [guia da lei da cadeirinha](/guias/lei-da-cadeirinha/).' },
  { p: 'Cadeirinha com ISOFIX é mais segura?', r: 'O ISOFIX reduz muito o risco de instalação errada, que é a falha mais comum. Uma cadeira bem instalada com o cinto do carro também protege, desde que fique firme. Explicamos as diferenças no guia [ISOFIX ou cinto](/guias/isofix-ou-cinto/).' },
  { p: 'O que é cadeirinha i-Size?', r: 'É a cadeira aprovada pela norma europeia R129, que classifica por altura, exige viagem de costas até pelo menos 15 meses e inclui teste de impacto lateral. O Inmetro aceita a R129. Veja [o que é i-Size](/guias/o-que-e-i-size/).' },
  { p: 'Vocês ganham comissão pelas indicações?', r: 'Sim. Os links para o Mercado Livre são de afiliado e podemos receber uma comissão, sem custo extra para você. As notas seguem a nossa [metodologia](/metodologia/) e não mudam por causa disso.' },
];
const schemaFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.p, acceptedAnswer: { '@type': 'Answer', text: f.r.replace(/\*\*|\[|\]\([^)]*\)/g, '') } })),
};

const posts = Object.values(import.meta.glob('./blog/*.md', { eager: true }) as Record<string, any>)
  .sort((a, b) => (b.frontmatter.data + b.url).localeCompare(a.frontmatter.data + a.url))
  .slice(0, 3);
const bento = [
  { c: 'b1', href: '/melhor-bebe-conforto/', t: 'Bebê conforto', f: 'Do nascimento a 13 kg', p: 'Sempre de costas, com ou sem base. Os que valem a pena e os que não.', img: produto('maxi-cosi-citi-2') },
  { c: 'b2', href: '/melhor-cadeirinha-para-carro/', t: 'Uma cadeira de 0 a 36 kg', f: 'Do nascimento a 10 anos', p: 'Multigrupo com e sem ISOFIX, comparada por quanto tempo fica de costas.', img: produto('safety-1st-multifix') },
  { c: 'b3', href: '/melhor-cadeirinha-giratoria-360/', t: 'Giratórias 360', f: '0 a 36 kg', p: 'Gira para a porta. Exige ISOFIX no carro.', img: produto('safety-1st-i-nxt-360') },
  { c: 'b4', href: '/melhor-assento-de-elevacao/', t: 'Assento de elevação', f: '15 a 36 kg', p: 'Para o cinto passar no ombro, não no pescoço.', img: produto('burigotto-protege-fix') },
  { c: 'b5', href: '/comparador/', t: 'Comparar todas', f: `${PRODUTOS.length} modelos`, p: 'Filtre por peso, ISOFIX, giro e preço.', img: produto('cosco-progress') },
];
---
<Base
  title="Cadeirinha Bebê: reviews de cadeirinhas para carro"
  description="Reviews e comparativos de cadeirinhas para carro, bebês conforto e assentos de elevação vendidos no Brasil, com ficha técnica completa e prós e contras."
  schema={schemaFaq}
>
  <section class="hero">
    <div class="wrap hero-grade">
      <div>
        <h1>A cadeirinha certa serve no seu filho e no seu carro.</h1>
        <p class="lead">A gente testa as cadeirinhas vendidas no Brasil e mostra o que o anúncio não conta: até quando o bebê fica de costas, se precisa de top tether, o registro no Inmetro e os defeitos de cada uma.</p>
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:28px">
          <a class="btn btn-marca" href="/melhor-cadeirinha-para-carro/">Ver as melhores de 2026</a>
          <a class="btn btn-linha" href="/comparador/">Comparar modelos</a>
        </div>
        <p style="margin:22px 0 0;font-size:.92rem;color:var(--suave)">{PRODUTOS.length} modelos avaliados. Revisado em outubro de 2026.</p>
      </div>

      <div class="seletor" id="seletor">
        <h2>Quanto seu filho pesa?</h2>
        <p class="ajuda">Arraste a régua. A gente mostra o tipo certo e os modelos com a melhor nota.</p>
        <div class="peso-saida"><strong id="kg">4</strong><span>kg</span></div>
        <p class="peso-fase" id="fase">Fase bebê: de costas, bebê conforto ou conversível</p>
        <label class="sr" for="peso">Peso da criança em quilos</label>
        <input class="faixa-range" type="range" id="peso" min="2" max="36" step="1" value="4" />
        <div class="faixa-legenda" aria-hidden="true"><span style="width:36%">bebê conforto</span><span style="width:14%">cadeirinha</span><span style="width:50%">assento de elevação</span></div>
        <div class="alternar" role="radiogroup" aria-label="O carro tem ISOFIX?">
          <label><input type="radio" name="isofix" value="sim" checked /><span>Carro com ISOFIX</span></label>
          <label><input type="radio" name="isofix" value="nao" /><span>Sem ISOFIX</span></label>
        </div>
        <div class="resultado" id="resultado" aria-live="polite"></div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <div class="cabeca">
        <h2>Comece pela fase do seu filho</h2>
        <p>A lei define o tipo de cadeira pela idade, pelo peso e pela altura. Cada lista compara só os modelos que servem naquela fase.</p>
      </div>
      <div class="bento">
        {bento.map((b) => (
          <a class={b.c} href={b.href}>
            <div>
              <span class="faixa">{b.f}</span>
              <h3 style="margin-top:8px">{b.t}</h3>
              <p>{b.p}</p>
            </div>
            <FotoProduto nome={b.img.imagem} alt={b.img.imagemAlt} />
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="wrap">
      <div class="cabeca">
        <h2>As que a gente indicaria para uma amiga</h2>
        <p>A melhor nota em cada situação, pela nossa <a href="/metodologia/">metodologia</a>. Os defeitos estão em cada review.</p>
      </div>
      <div class="grade rolar">
        {escolhas.map(({ p, selo }) => (
          <div class="caixa" style="display:flex;flex-direction:column;gap:12px;border-radius:var(--raio-g)">
            <span class="selo">{selo}</span>
            <a class="produto-foto" href={urlReview(p.slug)} aria-label={`Review do ${p.nome}`}><FotoProduto nome={p.imagem} alt={p.imagemAlt} /></a>
            <div style="display:flex;justify-content:space-between;gap:10px;align-items:center">
              <div><h3 style="font-size:1.12rem"><a href={urlReview(p.slug)} style="color:inherit;text-decoration:none">{p.nome}</a></h3><div style="color:var(--suave);font-size:.9rem">{p.faixa}</div></div>
              <Nota valor={p.nota} pequena />
            </div>
            <BotaoML href={p.mlUrl} texto="Ver preço" bloco />
          </div>
        ))}
      </div>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="secao">
      <div class="wrap">
        <div class="cabeca" style="display:flex;justify-content:space-between;align-items:end;gap:16px;max-width:none;flex-wrap:wrap">
          <div style="max-width:620px"><h2>Do blog</h2><p>Dúvidas que chegam até a gente, respondidas sem enrolação.</p></div>
          <a class="btn btn-linha" href="/blog/">Ver todos os artigos</a>
        </div>
        <div class="cards-blog rolar">
          {posts.map((post) => (
            <a class="card-blog" href={post.url.replace(/\/?$/, '/')}>
              <img src={imagemPost(post.url, 800)} alt="" width="800" height="533" loading="lazy" />
              <span class="chip" style="align-self:flex-start">{post.frontmatter.categoria}</span>
              <h3>{post.frontmatter.h1}</h3>
              <p>{post.frontmatter.intro}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="secao secao-tinta">
    <div class="wrap">
      <div class="cabeca"><h2>Como a gente avalia</h2><p>Cinco critérios com pesos públicos. Segurança pesa mais que qualquer outro.</p></div>
      <div class="confianca">
        <div><strong>A ficha que o anúncio esconde</strong><p>Limite de costas, top tether, norma e registro no Inmetro, conferidos com o fabricante.</p></div>
        <div><strong>Defeito também é informação</strong><p>Todo modelo tem pontos negativos, inclusive os primeiros da lista. A gente escreve quais são.</p></div>
        <div><strong>Preço com data</strong><p>Mostramos a faixa de referência e o mês. O valor exato está sempre no anúncio.</p></div>
      </div>
      <div style="display:flex;flex-wrap:wrap;gap:10px;margin-top:24px">
        <a class="btn btn-ml" href="/metodologia/">Ler a metodologia</a>
        <a class="btn" style="background:rgba(255,255,255,.1);color:#fff" href="/sobre/">Conhecer a equipe</a>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <div class="cabeca"><h2>Antes de comprar, leia</h2><p>O que a lei exige e o que muda entre as tecnologias.</p></div>
      <div class="grade rolar">
        <a class="caixa caixa-link" href="/guias/lei-da-cadeirinha/"><span class="chip">Lei</span><h3>Lei da cadeirinha 2026</h3><p>Idades, alturas, banco da frente, aplicativos e o valor da multa.</p></a>
        <a class="caixa caixa-link" href="/guias/o-que-e-i-size/"><span class="chip">Normas</span><h3>O que é i-Size</h3><p>A diferença para a norma antiga e se vale pagar mais por ela.</p></a>
        <a class="caixa caixa-link" href="/guias/isofix-ou-cinto/"><span class="chip">Instalação</span><h3>ISOFIX ou cinto?</h3><p>Como saber se o carro tem ISOFIX e como instalar sem folga.</p></a>
        <a class="caixa caixa-link" href="/comparativos/safety-1st-multifix-vs-cosco-progress/"><span class="chip">Comparativo</span><h3>Multifix ou Cosco Progress?</h3><p>As duas multigrupo mais vendidas, lado a lado.</p></a>
      </div>
    </div>
  </section>

  <section class="secao secao-areia">
    <div class="texto">
      <h2 style="margin-bottom:12px">Perguntas frequentes</h2>
      <Faq itens={faq} />
    </div>
  </section>

  <script define:vars={{ dados: dadosSeletor }}>
    (function () {
      var caixa = document.getElementById('seletor');
      var range = document.getElementById('peso');
      var kg = document.getElementById('kg');
      var fase = document.getElementById('fase');
      var saida = document.getElementById('resultado');
      function nomeFase(w) {
        if (w <= 13) return { t: 'Fase bebê: de costas, bebê conforto ou conversível', l: '/melhor-bebe-conforto/', lt: 'Ver bebês conforto' };
        if (w <= 18) return { t: 'Fase cadeirinha: cinto de 5 pontos', l: '/melhor-cadeirinha-para-carro/', lt: 'Ver cadeirinhas' };
        return { t: 'Fase assento de elevação: cinto do carro no ombro', l: '/melhor-assento-de-elevacao/', lt: 'Ver assentos de elevação' };
      }
      function render() {
        var w = +range.value;
        var iso = caixa.querySelector('input[name=isofix]:checked').value;
        kg.textContent = w;
        var f = nomeFase(w);
        fase.textContent = f.t;
        var lista = dados.filter(function (p) {
          if (w < p.kgMin || w > p.kgMax) return false;
          if (iso === 'nao' && !p.semIsofix) return false;
          return true;
        }).sort(function (a, b) { return b.nota - a.nota; }).slice(0, 3);
        var html = lista.map(function (p) {
          return '<a class="res" href="/reviews/' + p.slug + '/">' +
            '<img src="' + p.img + '" alt="" width="56" height="56" referrerpolicy="no-referrer" />' +
            '<span style="flex:1;min-width:0"><strong style="color:var(--tinta);display:block">' + p.nome + '</strong><span style="font-size:.86rem;color:var(--suave)">' + p.melhor + '</span></span>' +
            '<span class="nota nota-p" style="--v:' + p.nota + '"><span>' + p.nota.toFixed(1).replace('.', ',') + '</span></span></a>';
        }).join('');
        if (!lista.length) html = '<p style="margin:8px 0 0">Nenhum modelo nessa combinação. Veja todos no comparador.</p>';
        saida.innerHTML = html + '<p style="margin:14px 0 0;font-size:.92rem;display:flex;gap:16px;flex-wrap:wrap"><a href="' + f.l + '">' + f.lt + '</a><a href="/comparador/?peso=' + w + '&isofix=' + iso + '">Abrir no comparador</a></p>';
      }
      range.addEventListener('input', render);
      caixa.addEventListener('change', render);
      render();
    })();
  </script>
</Base>
