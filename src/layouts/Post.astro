---
import Base from './Base.astro';
import Faq from '../components/Faq.astro';
import FotoProduto from '../components/FotoProduto.astro';
import Nota from '../components/Nota.astro';
import BotaoML from '../components/BotaoML.astro';
import PostsRelacionados from '../components/PostsRelacionados.astro';
import { produto, urlReview } from '../data/produtos';
import { SITE } from '../config';
import { dataBR } from '../lib/datas';
import { imagemPost, postsRelacionados } from '../lib/blog';

const { frontmatter: f, headings = [] } = Astro.props;
const urlRel = Astro.url.pathname;
const url = new URL(urlRel, Astro.site).href;
const capa = imagemPost(urlRel);
const capaAbs = new URL(capa, Astro.site).href;
const citados = ((f.produtos ?? []) as string[]).map(produto);
const relacionados = postsRelacionados({ tags: f.tags ?? [], excluir: urlRel, limite: 3 });
const indice = (headings as { depth: number; slug: string; text: string }[]).filter((h) => h.depth === 2);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: f.h1,
    description: f.descricao,
    image: capaAbs,
    datePublished: f.data,
    dateModified: f.atualizado ?? f.data,
    author: { '@type': 'Organization', name: SITE.equipe, url: new URL('/sobre/', Astro.site).href },
    publisher: { '@id': new URL('/#organizacao', Astro.site).href },
    mainEntityOfPage: url,
    articleSection: f.categoria,
    inLanguage: 'pt-BR',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Início', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: new URL('/blog/', Astro.site).href },
      { '@type': 'ListItem', position: 3, name: f.h1, item: url },
    ],
  },
  ...(f.faq?.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: f.faq.map((q: any) => ({ '@type': 'Question', name: q.p, acceptedAnswer: { '@type': 'Answer', text: q.r.replace(/\*\*|\[|\]\([^)]*\)/g, '') } })),
      }]
    : []),
];
---
<Base title={f.titulo} description={f.descricao} schema={schema} ogImage={capaAbs} ogType="article" preloadImg={capaAbs}>
  <header class="cabeca-pagina" style="padding-bottom:28px">
    <div class="texto">
      <nav class="migalhas" aria-label="Você está em"><a href="/">Início</a> / <a href="/blog/">Blog</a> / {f.categoria}</nav>
      <h1 style="font-size:clamp(2rem,5vw,3.1rem)">{f.h1}</h1>
      {f.intro && <p class="lead">{f.intro}</p>}
      <div class="meta">
        <span>Atualizado em <strong><time datetime={f.atualizado ?? f.data}>{dataBR(f.atualizado ?? f.data)}</time></strong></span>
        <span>Por <a href="/sobre/">{SITE.equipe}</a></span>
      </div>
    </div>
  </header>

  <div class="post-capa">
    <img src={capa} srcset={`${imagemPost(urlRel, 800)} 800w, ${capa} 1600w`} sizes="(max-width: 1000px) 100vw, 960px" alt={f.capaAlt ?? ''} width="1600" height="800" fetchpriority="high" />
  </div>

  <article class="texto conteudo" style="padding-top:28px">
    {indice.length > 3 && (
      <details class="indice" open>
        <summary style="cursor:pointer;font-weight:700;color:var(--tinta)">Neste artigo</summary>
        <ol style="margin-top:8px">{indice.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
      </details>
    )}
    <slot />
  </article>

  {citados.length > 0 && (
    <section class="wrap" style="padding-top:24px">
      <h2 style="margin-bottom:18px">Modelos citados neste artigo</h2>
      <div class="grade rolar">
        {citados.map((p) => (
          <div class="caixa" style="display:flex;flex-direction:column;gap:10px;border-radius:var(--raio-g)">
            <a class="produto-foto" style="aspect-ratio:auto;height:170px" href={urlReview(p.slug)} aria-label={`Review do ${p.nome}`}><FotoProduto nome={p.imagem} alt={p.imagemAlt} /></a>
            <div style="display:flex;justify-content:space-between;gap:10px;align-items:center">
              <div><h3 style="font-size:1.05rem"><a href={urlReview(p.slug)} style="color:inherit;text-decoration:none">{p.nome}</a></h3><div style="color:var(--suave);font-size:.88rem">{p.faixa}</div></div>
              <Nota valor={p.nota} pequena />
            </div>
            <BotaoML href={p.mlUrl} texto="Ver preço" bloco />
          </div>
        ))}
      </div>
    </section>
  )}

  {f.faq?.length && (
    <section class="texto" style="padding:48px 20px 8px">
      <h2 style="margin-bottom:12px">Perguntas frequentes</h2>
      <Faq itens={f.faq} />
    </section>
  )}

  <PostsRelacionados posts={relacionados} titulo="Continue lendo" />
</Base>
