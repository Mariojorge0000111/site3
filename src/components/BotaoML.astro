  <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M7 18a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm10 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zM5.2 4l.6 2H21l-2.4 8.4c-.2.9-1 1.6-2 1.6H8.4c-.9 0-1.7-.6-2-1.5L3.6 4H1V2h4c.5 0 .9.3 1 .8L5.2 4z"/></svg>
  {texto}
</a>
