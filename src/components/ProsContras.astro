---
interface Props { pros: string[]; contras: string[]; }
const { pros, contras } = Astro.props;
---
<div class="pc">
  <div class="pros"><p class="pc-tit">Pontos positivos</p><ul>{pros.map((x) => <li>{x}</li>)}</ul></div>
  <div class="contras"><p class="pc-tit">Pontos negativos</p><ul>{contras.map((x) => <li>{x}</li>)}</ul></div>
</div>
