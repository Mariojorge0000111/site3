---
// Google Analytics 4 (propriedade cadeirinhabebe.com.br) + eventos de clique em botões e links
const ID = 'G-9EG8F3WXVY';
---
<script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ID}`}></script>
<script is:inline define:vars={{ ID }}>
  window.dataLayer = window.dataLayer || [];
  function gtag(){dataLayer.push(arguments);}
  gtag('js', new Date());
  gtag('config', ID);

  // Um único ouvinte para todos os cliques em links e botões do site.
  // Eventos: clique_afiliado (loja: mercado_livre | amazon), clique_whatsapp, clique_youtube,
  // clique_externo e clique_botao (botões e links com classe de botão internos).
  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest ? e.target.closest('a, button') : null;
    if (!el) return;
    var href = el.getAttribute('href') || '';
    var texto = (el.innerText || el.getAttribute('aria-label') || '').replace(/\s+/g, ' ').trim().slice(0, 100);
    var area = el.closest('header') ? 'topo' : el.closest('footer') ? 'rodape' : el.closest('aside') ? 'lateral' : el.closest('.grupo-ofertas') ? 'faixa_ofertas' : el.closest('table') ? 'tabela' : 'conteudo';
    var produtoEl = el.closest('[data-produto]');
    var base = {
      texto_link: texto,
      destino: href.slice(0, 200),
      area: area,
      produto: produtoEl ? produtoEl.getAttribute('data-produto') : (el.getAttribute('data-produto') || undefined),
    };
    var nome = null;
    if (/meli\.la|mercadolivre\.com|mercadolibre\.com/.test(href)) { nome = 'clique_afiliado'; base.loja = 'mercado_livre'; }
    else if (/amazon\.com\.br|amzn\.to/.test(href)) { nome = 'clique_afiliado'; base.loja = 'amazon'; }
    else if (/chat\.whatsapp\.com|wa\.me/.test(href)) { nome = 'clique_whatsapp'; }
    else if (/youtube\.com|youtu\.be/.test(href)) { nome = 'clique_youtube'; }
    else if (/^https?:\/\//.test(href) && href.indexOf(location.host) === -1) { nome = 'clique_externo'; }
    else if (el.tagName === 'BUTTON' || /\bbtn\b|botao|button/.test(el.className || '')) { nome = 'clique_botao'; }
    if (!nome) return;
    gtag('event', nome, base);
  }, true);
</script>
