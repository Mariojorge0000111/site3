---
interface Props { valor: number; pequena?: boolean; }
const { valor, pequena = false } = Astro.props;
---
<span class:list={['nota', { 'nota-p': pequena }]} aria-label={`Nota ${valor.toFixed(1).replace('.', ',')} de 10`}>
  {valor.toFixed(1).replace('.', ',')}{!pequena && <small>de 10</small>}
</span>
